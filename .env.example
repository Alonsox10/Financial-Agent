# ============================================
# Base de datos (PostgreSQL + pgvector)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nombre_de_tu_base_de_datos
POSTGRES_USER=tu_usuario_aquí
POSTGRES_PASSWORD=tu_contraseña_aquí

# Tamaño del pool de conexiones (opcional, valores por defecto si se omiten)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# LLM (OpenAI)
# ============================================
OPENAI_API_KEY=Tu clave_de_API_aquí
